
<%
  const pageTitle =
    typeof title !== "undefined" && title
      ? String(title)
      : "Gyansify Leaderboard | Performance Center";

  const pageDescription =
    typeof description !== "undefined" && description
      ? String(description)
      : "Manage agent performance, track activities, review team rankings and monitor achievements with Gyansify Leaderboard.";

  const pageThemeColor = "#5b4bdb";

  const pageCanonical =
    typeof canonicalUrl !== "undefined" && canonicalUrl
      ? String(canonicalUrl)
      : "";

  const pageRobots =
    typeof robots !== "undefined" && robots
      ? String(robots)
      : "noindex, nofollow";
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >

  <meta name="theme-color" content="<%= pageThemeColor %>">
  <meta name="color-scheme" content="light">

  <meta name="description" content="<%= pageDescription %>">
  <meta name="robots" content="<%= pageRobots %>">

  <title><%= pageTitle %></title>

  <% if (pageCanonical) { %>
    <link rel="canonical" href="<%= pageCanonical %>">
  <% } %>

  <!-- Favicon: add these files to public/ if available -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- Font performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  >

  <!-- Shared application foundation -->
  <style>
    :root {
      color-scheme: light;
      font-family: "Inter", -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;

      --brand-primary: #5b4bdb;
      --brand-primary-dark: #4338ca;
      --brand-soft: #f0edff;

      --text-primary: #182033;
      --text-secondary: #687287;

      --surface: #ffffff;
      --page-background: #f6f7fb;
      --border-color: #e6eaf2;

      --success: #15803d;
      --danger: #b42318;

      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;

      --shadow-card: 0 5px 20px rgba(25, 35, 65, 0.045);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      min-height: 100%;
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      min-height: 100vh;
      margin: 0;
      background: var(--page-background);
      color: var(--text-primary);
      font-family: inherit;
      font-size: 14px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    img,
    svg {
      max-width: 100%;
    }

    img {
      height: auto;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    a {
      color: var(--brand-primary);
    }

    button:focus-visible,
    a:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible {
      outline: 3px solid rgba(91, 75, 219, 0.35);
      outline-offset: 3px;
    }

    ::selection {
      background: #e3ddff;
      color: #27205e;
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
